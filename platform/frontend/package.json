{
  "name": "prometheus-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React frontend for the Prometheus Platform, talking to the FastAPI backend over its JSON/SSE contract (see backend/CONTRACT.md).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:full": "playwright test -c playwright.full.config.ts",
    "preview": "vite preview",
    "playground": "vite --open /dev/viewers/",
    "playground:preview": "vite build -c vite.playground.config.ts && vite preview -c vite.playground.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@kitware/vtk.js": "^36.5.1",
    "@reduxjs/toolkit": "2.14.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "@thatopen/components": "^3.6.0",
    "@thatopen/fragments": "^3.6.1",
    "@xyflow/react": "12.12.1",
    "daisyui": "^5.8.1",
    "highlight.js": "^11.11.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "9.3.1",
    "react-router": "7.18.5",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.5"
  }
}
