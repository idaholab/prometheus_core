{
  "name": "prometheus-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React frontend for the Prometheus Platform, talking to the FastAPI backend over its JSON/SSE contract (see backend/CONTRACT.md).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@kitware/vtk.js": "^36.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@thatopen/components": "^3.5.0",
    "@thatopen/fragments": "^3.4.0",
    "@xyflow/react": "12.12.0",
    "daisyui": "^5.7.50",
    "highlight.js": "^11.11.0",
    "lucide-react": "^0.292.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
