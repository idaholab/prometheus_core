{
  "name": "prometheus-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React frontend for the Prometheus Platform, talking to the FastAPI backend over its JSON/SSE contract (see backend/CONTRACT.md).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@kitware/vtk.js": "^36.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@thatopen/components": "^3.4.0",
    "@thatopen/fragments": "^3.4.0",
    "@xyflow/react": "12.12.0",
    "daisyui": "^5.5.19",
    "highlight.js": "^11.11.0",
    "lucide-react": "^0.292.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.9.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.12"
  }
}
