    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.2",
    "vite": "^5.4.21",
    "vite-plugin-node-polyfills": "^0.28.0"
