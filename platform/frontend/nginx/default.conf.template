server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Cheap liveness/readiness endpoint for probes (not the SPA).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Backend API (FastAPI `backend` service by default, container port 8000).
    # ${BACKEND_UPSTREAM} is filled in by the nginx image's envsubst step at start
    # (the Dockerfile defaults it to http://backend:8000); only variables that are
    # set in the environment are substituted, so nginx's own $host etc. are untouched.
    #
    # BACKEND_UPSTREAM must be scheme://host:port only, with no path or trailing
    # slash: a path makes nginx replace the matched `/api/` prefix, so API calls
    # would reach the wrong route. It must also be non-empty.
    # proxy_pass has no path so the original `/api/...` URI is preserved verbatim.
    #
    # buffering/cache are off and the read timeout is long so the /api/events SSE
    # stream is delivered incrementally rather than held until the response closes
    # (see backend/app/services/events.py).
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # notebook-render service (Starlette app on the agent-network, container port 8000).
    # Serves baked UQ notebook reports (/notebook/render/{id}), same-origin.
    # proxy_pass has no path so the original `/notebook/...` URI is preserved verbatim.
    location /notebook/ {
        proxy_pass http://notebook-render:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # SPA fallback for client-side routing.
    location / {
        try_files $uri /index.html;
    }
}
