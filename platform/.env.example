# Prometheus Platform environment
#
# Copy this file to .env and set LLM_CONFIG_PROFILE and LLM_API_KEY.
# Every make target fills the blank secrets in section 2 and never
# overwrites a value that is set.
#
# A commented-out variable shows its default. Uncomment it to override.

# =============================================================================
# 1. LLM provider
# =============================================================================

# Set LLM_CONFIG_PROFILE to one of these values. There is no default, and
# `make up` asks for one in a terminal if it is blank.
#   anthropic     Anthropic directly.
#   openai        OpenAI directly.
#   inl_hpc       INL HPC model service.
#   inl_litellm   INL hosted LiteLLM service.
#   amsc          American Science Cloud I2 model service.
#   anl_asksage   ANL AskSage model service.
LLM_CONFIG_PROFILE=

# The API key for your profile's provider. For anl_asksage, use the AskSage
# static API key.
LLM_API_KEY=

# The embeddings key. Agents that use embeddings need it with the anthropic and
# anl_asksage profiles.
EMBEDDING_API_KEY=

# A custom LLM config YAML that replaces LLM_CONFIG_PROFILE. The path must
# exist inside every agent container.
LLM_CONFIG_FILE=

# =============================================================================
# 2. Secrets
# =============================================================================
# Make fills each blank secret with the command above it. Keep both
# *_DB_PASSWORD values after the first start, because Postgres stores them in
# its data volume. Back up this file. See docs/docs/dev-docs/encryption-and-keys.md.

# Authenticates calls between agents.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AGENT_SECRET=

# Valkey password.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=

# Password for admin-db, which stores users, OIDC config and signing keys.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_DB_PASSWORD=

# Signs the browser session cookie. Changing it logs everyone out.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_JWT_SECRET=

# Encrypts OIDC client secrets and signing keys in admin-db.
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ADMIN_DB_ENCRYPTION_KEY=

# =============================================================================
# 3. Multi-user identity
# =============================================================================
# The backend signs a short-lived token per turn that tells agents who the
# caller is. It creates its signing key on first start. Rotate the key under
# Admin > Signing Keys. See docs/docs/dev-docs/multi-user-setup.md.
USER_IDENTITY_REQUIRED=true

# Where agents fetch verification keys. Change it for agents outside this stack.
#JWKS_URL=http://backend:8000/.well-known/jwks.json
#USER_IDENTITY_ISS=prometheus-platform
#USER_IDENTITY_AUD=prometheus-agents
# Token lifetime in seconds.
#USER_IDENTITY_TTL=7200
# A static keypair from prometheus-identity-keygen. The private key belongs on
# the backend only.
#USER_IDENTITY_PRIVATE_KEY=
#USER_IDENTITY_PUBLIC_KEY=

# Per-user credential backend: env or vault.
#CREDENTIAL_BROKER=env

# =============================================================================
# 4. OIDC single sign-on
# =============================================================================
# The URL the browser uses to reach the platform. Set it before adding a
# provider under Admin > Identity Providers. Use http://localhost:5150 for dev
# and http://localhost:8080 for prod. Register
# <this value>/api/auth/callback/<provider_id> with each provider.
BACKEND_PUBLIC_URL=

# =============================================================================
# 5. Host ports
# =============================================================================
REDIS_LOCAL_PORT=6379
BACKEND_PORT=8600
FRONTEND_DEV_PORT=5150
FRONTEND_PROD_PORT=8080
# Published when PROMETHEUS_SYSTEM_TESTING=true.
CLIENT_AGENT_PORT=8001

# =============================================================================
# 6. Backend tuning
# =============================================================================
# Maximum upload size in bytes.
#PROMETHEUS_MAX_UPLOAD_BYTES=104857600
# Mesh conversion processes per backend worker.
#PROMETHEUS_MESH_WORKERS=2
# Seconds before a mesh conversion falls back to a download.
#PROMETHEUS_MESH_TIMEOUT_SECONDS=120
# Backend workers. Each one runs its own mesh pool, so raise the memory limit
# with it.
#BACKEND_WORKERS=1
#BACKEND_MEM_LIMIT=4g

# =============================================================================
# 7. DeepLynx storage (required by standard agent execution)
# =============================================================================
# Choose exactly one authentication method: JWT, or both key and secret.
# Organization and project IDs are required. The base URL is optional and uses
# the SDK default when omitted. The data source ID is optional when the project
# has a default data source. See ../sdk/docs/ENV_SETUP.md.
#
# With LOCAL_DEEPLYNX=true (section 8), `make deeplynx-setup` fills these in
# for the local DeepLynx on every start; leave them as they are.
DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1
DEEPLYNX_KEY=
DEEPLYNX_SECRET=
DEEPLYNX_JWT_TOKEN=
DEEPLYNX_ORG_ID=
DEEPLYNX_PROJECT_ID=
#DEEPLYNX_DATA_SOURCE_ID=

# Secrets of the local DeepLynx (LOCAL_DEEPLYNX=true). Unused otherwise. Keep
# DEEPLYNX_DB_PASSWORD after the first start, like the other *_DB_PASSWORD
# values. The encryption key and IV encrypt credentials DeepLynx stores.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DEEPLYNX_DB_PASSWORD=
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEEPLYNX_JWT_SECRET=
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DEEPLYNX_ENCRYPTION_KEY=
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(16)).decode())"
DEEPLYNX_ENCRYPTION_IV=
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DEEPLYNX_UI_SECRET=

# Corporate proxy for the image builds.
#HTTP_PROXY=http://proxy:8080
#HTTPS_PROXY=http://proxy:8080
#NO_PROXY=localhost,127.0.0.1,prometheus.host.internal,backend,redis,client-agent

# =============================================================================
# 8. Build options
# =============================================================================
# Build the base image from ../sdk instead of pulling it from the registry.
#LOCAL_SDK=false
# The registry base image. The Makefile sets the default tag.
#PROMETHEUS_API_BASE_IMAGE_REPO=ghcr.io/idaholab/prometheus_core/prometheus_sdk-devel
#PROMETHEUS_API_BASE_IMAGE_HASH=
# Include the debug agents in agents/debug-agents.
#DEBUG_AGENTS=false
# Include the optional agents in agents/optional.
#OPTIONAL_AGENTS=false
# Run DeepLynx locally from its published images and point the platform at it.
# See docs/docs/local-deeplynx.md. The UI only works with the API on 5000.
#LOCAL_DEEPLYNX=false
#DEEPLYNX_SERVER_PORT=5000
#DEEPLYNX_UI_PORT=3000
# Publish the client-agent on CLIENT_AGENT_PORT for system tests.
#PROMETHEUS_SYSTEM_TESTING=false
# Let specialist agents accept calls without AGENT_SECRET. Development only.
#AGENT_SECRET_REQUIRED=true
