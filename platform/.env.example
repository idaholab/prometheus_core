# Prometheus Platform - Environment Variables
#
# You normally don't copy this file by hand: `make up` (and every other make
# target that talks to Docker) runs scripts/init_env.py, which
#   1. copies this file to .env if .env does not exist yet,
#   2. fills every blank secret in section 2 by running the python3 one-liner
#      shown above it, and
#   3. if the API key for your LLM profile (section 1) is blank -- the one
#      value it cannot generate -- lets you pick a profile from a menu and
#      type its key (in a terminal), or stops with an error otherwise.
# Run it yourself with `python3 scripts/init_env.py` before a plain
# `docker compose up`. It never overwrites a value that is already set.
#
# Commented-out variables show their built-in default; uncomment to override.

# =============================================================================
# 1. REQUIRED -- set before the first start
# =============================================================================

# LLM provider used by the agents. Required: there is no default, and
# `make up` asks for one (or fails, when not run in a terminal) if it is blank.
# Every profile reads its key from LLM_API_KEY; put the key for the provider
# you pick there:
#   anthropic    -> Anthropic key, plus EMBEDDING_API_KEY when using embeddings
#   openai       -> OpenAI key
#   inl_hpc      -> INL HPC key
#   inl_litellm  -> INL LiteLLM key
#   amsc         -> AMSC I2 key
#   anl_asksage  -> AskSage static API key (not an OpenAI key), plus
#                   EMBEDDING_API_KEY when using embeddings
# See README.md, "Choose an LLM profile," for descriptions and examples.
LLM_CONFIG_PROFILE=

# The API key for the profile above.
LLM_API_KEY=
# Embeddings provider key, used by the anthropic and anl_asksage profiles
# (neither chat provider supplies embeddings).
EMBEDDING_API_KEY=

# Advanced: path to a custom LLM config YAML that overrides LLM_CONFIG_PROFILE.
# It must exist inside every agent container. Leave blank otherwise.
LLM_CONFIG_FILE=

# =============================================================================
# 2. SECRETS -- generated by scripts/init_env.py when blank
# =============================================================================
# Do NOT change the two *_DB_PASSWORD values after the first start: Postgres
# keeps the original in its data volume and the service gets locked out.
# What breaks when any of these is lost or rotated:
# docs/docs/dev-docs/encryption-and-keys.md

# Bearer token for inter-agent A2A authentication.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AGENT_SECRET=

# Valkey (Redis-compatible) password. Every service gets it next to the compose
# default REDIS_URL=redis://redis:6379, so REDIS_URL itself needs no setting.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=

# Password for admin-db (local users, OIDC config, signing keys).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_DB_PASSWORD=

# Signs the browser session cookie. Changing it logs everyone out once.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_JWT_SECRET=

# Fernet key that encrypts OIDC client secrets and signing private keys at rest
# in admin-db. If you lose it, those rows can't be read -- back up your .env.
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ADMIN_DB_ENCRYPTION_KEY=

# =============================================================================
# 3. Multi-user identity
# =============================================================================
# The backend mints a short-lived RS256 JWT per turn so agents know who the
# caller is. With USER_IDENTITY_REQUIRED=true, agents reject every request until
# a signing key exists. The backend creates and activates a key on its first
# start; rotate it under Admin > Signing Keys. Agents pick it up from
# the backend's JWKS endpoint with no restart. For a quick local smoke test
# without any key, set this to false.
# See docs/docs/dev-docs/multi-user-setup.md.
USER_IDENTITY_REQUIRED=true

# Where agents fetch verification keys. Override only for an agent outside this
# docker network (give it this platform's public JWKS URL).
#JWKS_URL=http://backend:8000/.well-known/jwks.json
#USER_IDENTITY_ISS=prometheus-platform
#USER_IDENTITY_AUD=prometheus-agents
# Minted-token lifetime in seconds.
#USER_IDENTITY_TTL=7200
# Static-key alternative to Admin > Signing Keys (`prometheus-identity-keygen`).
# PRIVATE belongs on the backend only. Agents use PUBLIC only when they have no
# JWKS_URL, which never happens inside this compose stack.
#USER_IDENTITY_PRIVATE_KEY=
#USER_IDENTITY_PUBLIC_KEY=

# Per-user credential backend: "env" (global DEEPLYNX_*/SLURM_* credentials)
# or "vault" (per-user Vault policies).
#CREDENTIAL_BROKER=env

# =============================================================================
# 4. OIDC single sign-on -- needed once you add a provider under
#    Admin > Identity Providers
# =============================================================================
# The origin the browser uses to reach the platform; the backend builds the OIDC
# redirect_uri from it. When blank, the backend guesses from the incoming
# request, which is wrong behind any proxy (Vite dev server, nginx), and
# providers reject the login with a redirect_uri mismatch.
#   dev (Vite):  http://localhost:5150     prod (nginx):  http://localhost:8080
#   real deployment:                       https://prometheus.example.com
# Register <this value>/api/auth/callback/<provider_id> with every provider.
BACKEND_PUBLIC_URL=

# =============================================================================
# 5. Host ports
# =============================================================================
REDIS_LOCAL_PORT=6379
BACKEND_PORT=8600
FRONTEND_DEV_PORT=5150
FRONTEND_PROD_PORT=8080
# Published only when PROMETHEUS_SYSTEM_TESTING=true (section 8).
CLIENT_AGENT_PORT=8001

# =============================================================================
# 6. Backend tuning
# =============================================================================
# Max upload size in bytes (frontend and client-agent staging). 100 MiB.
#PROMETHEUS_MAX_UPLOAD_BYTES=104857600
# Exodus/STL -> VTP mesh conversion runs in a VTK subprocess pool, so a crash
# costs one artifact instead of the whole backend. Pool size is PER web worker.
#PROMETHEUS_MESH_WORKERS=2
# Per-conversion wall-clock budget; on expiry the artifact degrades to a download.
#PROMETHEUS_MESH_TIMEOUT_SECONDS=120
# uvicorn workers. >1 is supported (all session state lives in Valkey), but each
# worker gets its own VTK pool, so BACKEND_MEM_LIMIT must cover the total.
#BACKEND_WORKERS=1
#BACKEND_MEM_LIMIT=4g

# =============================================================================
# 7. DeepLynx storage (required by standard agent execution)
# =============================================================================
# Choose exactly one authentication method: JWT, or both key and secret.
# Organization and project IDs are required. The base URL is optional and uses
# the SDK default when omitted. The data source ID is optional when the project
# has a default data source. See ../sdk/docs/ENV_SETUP.md.
DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1
DEEPLYNX_KEY=
DEEPLYNX_SECRET=
DEEPLYNX_JWT_TOKEN=
DEEPLYNX_ORG_ID=
DEEPLYNX_PROJECT_ID=
#DEEPLYNX_DATA_SOURCE_ID=


# Corporate proxy (passed to the image builds).
#HTTP_PROXY=http://proxy:8080
#HTTPS_PROXY=http://proxy:8080
#NO_PROXY=localhost,127.0.0.1,prometheus.host.internal,backend,redis,client-agent

# =============================================================================
# 8. Build and make options (read by the Makefile)
# =============================================================================
# The prometheus_api base image is only used by agents scaffolded from
# agent-template/; the in-repo agents and the backend install ../sdk directly.
# No access to containers.github.inl.gov? Set LOCAL_SDK=true to build the base
# image from ../sdk locally (prometheus_api:local) and build those agents FROM
# it. Overrides the two variables below.
#LOCAL_SDK=false
# Pin a different registry base image. The default tag lives in the Makefile.
#PROMETHEUS_API_BASE_IMAGE_REPO=containers.github.inl.gov/genesis/prometheus_api
#PROMETHEUS_API_BASE_IMAGE_HASH=
# Also include the debug agents under agents/debug-agents/*.
#DEBUG_AGENTS=false
# Also include the heavy optional agents under agents/optional/* (OSTI research).
#OPTIONAL_AGENTS=false
# Publish the client-agent on CLIENT_AGENT_PORT for host-driven system tests.
#PROMETHEUS_SYSTEM_TESTING=false
# Development only: let specialist agents accept calls without AGENT_SECRET.
#AGENT_SECRET_REQUIRED=true
