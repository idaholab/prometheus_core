# Project manifest (TOML sample)
[project]
name = "prometheus-demo"
version = "0.1.0"
description = "Δ → ü ✓"
requires-python = ">=3.12"
dependencies = [
  "httpx>=0.26.0",
  "pydantic>=2.0.0",
]

[tool.ruff]
line-length = 100
select = ["E", "F", "I"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]

[[tool.uv.index]]
name = "internal"
url = "https://pypi.example.org/simple"
enabled = true
ratio = 0.75
created = 2026-01-15T09:30:00Z
