// Typed reading store (TypeScript sample)
interface Reading {
  id: string;
  value: number;
  unit?: "K" | "C";
}

type Summary<T extends Reading = Reading> = {
  count: number;
  peak: T | null;
};

enum Status {
  Idle,
  Running = 2,
}

export class Store<T extends Reading> {
  private items: T[] = [];
  public status: Status = Status.Idle;

  add(item: T): this {
    this.items.push(item);
    return this;
  }

  summary(): Summary<T> {
    const peak = this.items.reduce<T | null>((a, b) => (a && a.value > b.value ? a : b), null);
    return { count: this.items.length, peak };
  }
}

const label: string = `Δ → ü ✓ ${Status[Status.Running]}`;
// A deliberately very long line to check horizontal scrolling: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
