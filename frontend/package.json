{
  "name": "prometheus-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React frontend for the Prometheus Platform, talking to the FastAPI backend over its JSON/SSE contract (see backend/CONTRACT.md).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kitware/vtk.js": "^36.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@thatopen/components": "^3.4.0",
    "@thatopen/fragments": "^3.4.0",
    "daisyui": "^5.5.19",
    "highlight.js": "^11.11.0",
    "lucide-react": "^0.292.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.2",
    "vite": "^5.4.21",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
