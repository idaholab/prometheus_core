# Copy this file to .env and fill in your credentials
# The .env file is gitignored and will not be committed

#
# Agent Configuration
#

AGENT_PORT=8000  # Port the agent binds to; defaults to 8000
# EXTERNAL_AGENT_URL=http://my-host:9002  # Full URL advertised to the registry; auto-derived from container hostname + AGENT_PORT when not set
REGISTRY_URL=http://litellm:4000  # Agent registry and default LLM registry profile URL
# REGISTRY_MAX_RETRIES=10  # Registration retries after the first attempt

#
# LLMClient config
#

# Select an installed profile: the name of any YAML file in
# prometheus_api/llm_configs/ (e.g. registry, openai, anthropic).
# The default registry profile reads REGISTRY_URL.
# LLM_CONFIG_PROFILE=registry

# A custom YAML path overrides LLM_CONFIG_PROFILE.
# LLM_CONFIG_FILE=./llm_config.yaml

# Every installed profile reads its provider key from LLM_API_KEY. The
# anthropic, anl_asksage and registry profiles also read EMBEDDING_API_KEY for
# the embedding flavor.
# LLM_API_KEY=your-provider-api-key
# EMBEDDING_API_KEY=your-embedding-provider-api-key

# Keep prompt and embedding text hidden in debug logs unless explicitly enabled
LLM_DEBUG_LOG_MESSAGES=false

# Optional MLflow tracing for LLMClient chat calls. Requires mlflow to be installed
# in the runtime environment when enabled.
ENABLE_MLFLOW_TRACING=false
# MLFLOW_TRACKING_URI=https://mlflow.example.org
# MLFLOW_EXPERIMENT_NAME=prometheus-llm
# MLFLOW_API_KEY=your-mlflow-api-key  # sent as X-Api-Key (e.g. AMSC MLflow)

# Security: Shared Secret Authentication
# REQUIRED in production/multi-user environments
# All agents in your deployment must use the same secret
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SECRET=

# Optional: Disable authentication (DEVELOPMENT ONLY - NOT RECOMMENDED)
# Set to 'false' to disable authentication when AGENT_SECRET is not set
# AGENT_SECRET_REQUIRED=true

# Proxy Configuration (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# SSL Configuration (if needed)
# SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.pem
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-bundle.pem

#
# StorageClient config
#

# Required: API Authentication
# Use either API key/secret OR JWT token (not both)

# Option 1: API Key Authentication (recommended)
DEEPLYNX_KEY=your-api-key-here
DEEPLYNX_SECRET=your-api-secret-here

# Option 2: JWT Token Authentication (alternative)
# DEEPLYNX_JWT_TOKEN=your-jwt-token-here

# Required: Organization and Project IDs
DEEPLYNX_ORG_ID=123
DEEPLYNX_PROJECT_ID=456

# Optional but recommended: Data Source ID (required for creating records)
# DEEPLYNX_DATA_SOURCE_ID=789

# Optional: Custom Base URL (defaults to INL DeepLynx instance)
# DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1

# Optional: Connection Settings (uncomment to customize)
# DEEPLYNX_TIMEOUT=30.0
# DEEPLYNX_MAX_RETRIES=3
# DEEPLYNX_VERIFY_SSL=true
